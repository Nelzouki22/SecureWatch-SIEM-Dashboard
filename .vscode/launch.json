{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SecureWatch Flask",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "env": {"FLASK_APP": "app.py", "FLASK_DEBUG": "1"},
      "args": ["run", "--no-debugger", "--host=0.0.0.0", "--port=5000"],
      "jinja": true,
      "justMyCode": false
    },
    {
      "name": "Python Tests (pytest)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests", "-v"]
    }
  ]
}